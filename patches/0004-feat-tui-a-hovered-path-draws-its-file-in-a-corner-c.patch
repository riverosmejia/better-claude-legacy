diff --git a/ui-tui/src/components/pathCard.tsx b/ui-tui/src/components/pathCard.tsx
new file mode 100644
index 00000000000..b5fa8f94069
--- /dev/null
+++ b/ui-tui/src/components/pathCard.tsx
@@ -0,0 +1,61 @@
+import { NoSelect, Text } from '@hermes/ink'
+import { useStore } from '@nanostores/react'
+import { memo, useMemo } from 'react'
+
+import { $pathHover } from '../lib/pathHover.js'
+import { pathPreview } from '../lib/pathPreview.js'
+import type { Theme } from '../theme.js'
+
+/**
+ * The card a path answers a hover with: what the file is, and its lines, the one
+ * the path named marked — drawn in the terminal, in the corner of the transcript,
+ * never in a window of its own.
+ *
+ * It is fixed to the bottom-right of the transcript rather than following the
+ * pointer: ink's hover handlers get no coordinates (only clicks do), so a card
+ * that chased the cursor would need the event dispatcher itself changed. This one
+ * holds still, never covers the composer, and needs nothing from the terminal
+ * beyond the hover event itself.
+ */
+const WIDTH = 76
+const ROWS = 14
+
+export const PathCard = memo(function PathCard({ cols, t }: { cols: number; t: Theme }) {
+  const hover = useStore($pathHover)
+
+  const lines = useMemo(() => {
+    if (!hover) {
+      return []
+    }
+
+    const width = Math.max(20, Math.min(WIDTH, cols - 4))
+
+    return pathPreview(hover.path, hover.line, ROWS)
+      .split('\n')
+      .slice(0, ROWS + 1)
+      .map(line => (line.length > width - 2 ? `${line.slice(0, width - 3)}…` : line))
+  }, [cols, hover])
+
+  if (!hover || !lines.length) {
+    return null
+  }
+
+  return (
+    <NoSelect
+      borderColor={t.color.border}
+      borderStyle="round"
+      bottom={0}
+      flexDirection="column"
+      paddingX={1}
+      position="absolute"
+      right={0}
+      width={Math.max(20, Math.min(WIDTH, cols - 4))}
+    >
+      {lines.map((line, index) => (
+        <Text color={index === 0 ? t.color.accent : t.color.label} key={index} wrap="truncate-end">
+          {line}
+        </Text>
+      ))}
+    </NoSelect>
+  )
+})
