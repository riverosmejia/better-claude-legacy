+  const parts: ReactNode[] = []
+
+  let at = 0
+
+  for (const hit of hits) {
+    if (hit.start > at) {
+      parts.push(<Text key={`t${parts.length}`}>{text.slice(at, hit.start)}</Text>)
+    }
+
+    parts.push(
+      <Link key={`p${parts.length}`} url={fileUrl(hit.path, hit.line)}>
+        {hit.label}
+      </Link>
+    )
+
+    at = hit.end
+  }
+
+  if (at < text.length) {
+    parts.push(<Text key={`t${parts.length}`}>{text.slice(at)}</Text>)
+  }
+
+  return parts
+}
