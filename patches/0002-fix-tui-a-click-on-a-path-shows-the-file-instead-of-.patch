@@ -0,0 +1,21 @@
+import { atom } from 'nanostores'
+
+/**
+ * What a click on a path in an answer asked to see.
+ *
+ * The click cannot do anything the terminal can show by itself: there is no
+ * pointer position for a card, no clipboard that works over ssh, and handing the
+ * file to an editor would take the screen away mid-turn. So the click leaves a
+ * request here and the app answers it — the same pager the `/help` panels use.
+ */
+export type PathPeek = { path: string; line?: number }
+
+export const $pathPeek = atom<PathPeek | null>(null)
+
+export const requestPathPeek = (path: string, line?: number): void => {
+  $pathPeek.set({ path, ...(line === undefined ? {} : { line }) })
+}
+
+export const clearPathPeek = (): void => {
+  $pathPeek.set(null)
+}
