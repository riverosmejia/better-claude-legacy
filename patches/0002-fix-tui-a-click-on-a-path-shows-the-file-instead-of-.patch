--- /dev/null
+++ b/ui-tui/src/lib/pathPreview.ts
@@ -0,0 +1,58 @@
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+
+/**
+ * The text a click on a path shows in the TUI's pager: what the file is, and its
+ * lines, numbered, with the one the path named marked.
+ *
+ * Everything that can go wrong (gone, unreadable, binary, enormous, a folder)
+ * comes back as a line that says so — a click always answers.
+ */
+
+const MAX_BYTES = 2 * 1024 * 1024
+const MAX_DIR_ENTRIES = 200
+const ROWS = 60
+const CONTEXT = 10
+
+export function pathPreview(path: string, line?: number, rows = ROWS): string {
+  try {
+    const stat = statSync(path)
+
+    if (stat.isDirectory()) {
+      const entries = readdirSync(path).sort()
+      const shown = entries.slice(0, MAX_DIR_ENTRIES).map(name => `  ${name}`)
+
+      return [`${path}/  ·  directory, ${entries.length} entries`, ...shown].join('\n')
+    }
+
+    if (stat.size > MAX_BYTES) {
+      return `${path}\n(too large to show: ${Math.round(stat.size / 1024)}k)`
+    }
+
+    const text = readFileSync(path, 'utf8')
+
+    if (text.slice(0, 4096).includes('\0')) {
+      return `${path}\n(binary file, ${Math.round(stat.size / 1024)}k)`
+    }
+
+    const all = text.split('\n')
+
+    // A file that ends in a newline gains an empty last line that is not one.
+    if (all.length > 1 && all.at(-1) === '') {
+      all.pop()
+    }
+
+    const mark = line !== undefined && line >= 1 && line <= all.length ? line : 0
+    const first = mark > 0 ? Math.max(1, mark - CONTEXT) : 1
+
+    const shown = all.slice(first - 1, first - 1 + rows).map((row, offset) => {
+      const number = first + offset
+      const flag = number === mark ? '▸' : ' '
+
+      return `${flag}${String(number).padStart(5)}  ${row.replaceAll('\t', '  ').trimEnd()}`
+    })
+
+    return [`${path}${mark > 0 ? `:${mark}` : ''}  ·  ${all.length} lines`, ...shown].join('\n')
+  } catch (error) {
+    return `${path}\n(cannot read it: ${(error as Error).message})`
+  }
+}
