From 1c2de69628471fa7948024615d62f55f76af939a Mon Sep 17 00:00:00 2001
From: riverosmejia <riverosmejia@users.noreply.github.com>
Date: Sun, 1 Nov 2026 15:53:16 -0500
Subject: [PATCH 3/4] fix(tui): link a path written as a code span, which is
 the usual shape
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Answers name files inside backticks far more often than in prose, and the code
branch of MdInline drew them as plain code — so on a message like
'el binario esta en `/mnt/terdisco/x.AppImage`' nothing was linked and a click
had nothing to act on. A span that is only a path now carries a Link, with the
code styling untouched.
---
 ui-tui/src/__tests__/pathLinks.test.ts | 11 ++++++++++-
 ui-tui/src/components/markdown.tsx     | 10 ++++++++--
 ui-tui/src/lib/paths.ts                | 23 +++++++++++++++++++++++
 3 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/ui-tui/src/__tests__/pathLinks.test.ts b/ui-tui/src/__tests__/pathLinks.test.ts
index 6ab6e66e60a..fa98382e86b 100644
--- a/ui-tui/src/__tests__/pathLinks.test.ts
+++ b/ui-tui/src/__tests__/pathLinks.test.ts
@@ -8,7 +8,7 @@ import { localUrl, openExternalUrl, parseSafeUrl } from '../lib/openExternalUrl.
 import { openWithUserCommand } from '../lib/openLocalPath.js'
 import { $pathPeek, clearPathPeek } from '../lib/pathPeek.js'
 import { pathPreview } from '../lib/pathPreview.js'
-import { existingPaths, fileUrl, lineOf, localPathOf, pathOfSpan, pathsIn, resolvePath } from '../lib/paths.js'
+import { codeSpanPath, existingPaths, fileUrl, lineOf, localPathOf, pathOfSpan, pathsIn, resolvePath } from '../lib/paths.js'
 
 const found = (text: string) => pathsIn(text).map(f => [text.slice(f.start, f.end), f.target])
 
@@ -77,6 +77,15 @@ describe('existingPaths', () => {
     expect(hits.map(hit => [hit.label, hit.path])).toEqual([['~/My Videos/a b.mp4', join(home, 'My Videos', 'a b.mp4')]])
   })
 
+  it('links a whole code span that is a path, which is how answers name files', () => {
+    // The write-up shape: `path` between backticks, not prose.
+    expect(codeSpanPath(`${app}/README.md`, app, home)).toMatchObject({ path: `${app}/README.md` })
+    expect(codeSpanPath('src/app.ts:1', app, home)).toMatchObject({ path: `${app}/src/app.ts`, line: 1 })
+    // Anything that is not only a path stays plain code.
+    expect(codeSpanPath('npm run build', app, home)).toBeUndefined()
+    expect(codeSpanPath('/no/existe.ts', app, home)).toBeUndefined()
+  })
+
   it('drops addresses and missing files, and stops at the limit', () => {
     const text = 'https://example.com/a/b.html y /no/existe/x.ts y src/app.ts y README.md'
     expect(existingPaths(text, app, home).map(hit => hit.label)).toEqual(['src/app.ts', 'README.md'])
diff --git a/ui-tui/src/components/markdown.tsx b/ui-tui/src/components/markdown.tsx
index a951f2f925e..a728193832c 100644
--- a/ui-tui/src/components/markdown.tsx
+++ b/ui-tui/src/components/markdown.tsx
@@ -4,7 +4,7 @@ import { Fragment, memo, type ReactNode, useMemo } from 'react'
 import { ensureEmojiPresentation } from '../lib/emoji.js'
 import { normalizeExternalUrl } from '../lib/externalLink.js'
 import { BOX_CLOSE, BOX_OPEN, texToUnicode } from '../lib/mathUnicode.js'
-import { existingPaths, fileUrl } from '../lib/paths.js'
+import { codeSpanPath, existingPaths, fileUrl } from '../lib/paths.js'
 import { highlightLine, isHighlightable } from '../lib/syntax.js'
 import type { Theme } from '../theme.js'
 
@@ -611,9 +611,15 @@ function MdInline({ color, t, text }: { color?: string; t: Theme; text: string }
       // Code is the one wrap that does NOT recurse — inline `code` spans
       // are verbatim by definition. Letting MdInline reprocess them
       // would corrupt regex examples and shell snippets.
+      //
+      // A span that is nothing but a path is still a link: answers name paths
+      // inside backticks more often than in prose, so this is the shape that
+      // matters most. The code styling stays exactly as it was.
+      const span = codeSpanPath(m[7])
+
       parts.push(
         <Text color={t.color.accent} dimColor key={parts.length}>
-          {m[7]}
+          {span ? <Link url={fileUrl(span.path, span.line)}>{m[7]}</Link> : m[7]}
         </Text>
       )
     } else if (m[8] ?? m[9]) {
diff --git a/ui-tui/src/lib/paths.ts b/ui-tui/src/lib/paths.ts
index f5c77c0c22d..2bf2bd161a5 100644
--- a/ui-tui/src/lib/paths.ts
+++ b/ui-tui/src/lib/paths.ts
@@ -224,3 +224,26 @@ export function localPathOf(url: URL): { path: string; line?: number } {
 /** Whether a path is something we are willing to hand to a click handler. */
 export const isLocalFile = (path: string): boolean =>
   path.startsWith('/') && !path.includes('\0') && existsSync(path)
+
+/**
+ * The path a whole inline code span names, when it leads somewhere:
+ * `` `src/app.ts:42` ``, `` `~/My Videos/a b.mp4` ``. Answers are written mostly
+ * with paths inside backticks, so this is the shape that matters most.
+ */
+export function codeSpanPath(code: string, cwd: string = process.cwd(), home = homedir()): PathHit | undefined {
+  const target = pathOfSpan(code)
+
+  if (target === undefined) {
+    return undefined
+  }
+
+  const path = resolvePath(target, cwd, home)
+
+  if (!path || !there(path)) {
+    return undefined
+  }
+
+  const line = lineOf(code)
+
+  return { start: 0, end: code.length, label: code, path, ...(line === undefined ? {} : { line }) }
+}
